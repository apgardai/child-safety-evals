# ── Postgres (FastAPI `server/`) ─────────────────────────────────────────────
DATABASE_URL=

# Celery task queue (FastAPI `server/` — broker for long-running evaluations)
REDIS_BROKER_URL=redis://localhost:6379/0
# REDIS_RESULT_BACKEND=redis://localhost:6379/0

INTERNAL_API_URL=http://localhost:8100

# Optional: set cookie Domain to share session across app + api subdomains.
# SESSION_DOMAIN=.apgardai.com

# Firebase Admin (Next.js `ui/`) — prefer a service account JSON path (do not commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or set these instead of the file (e.g. in CI):
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase Web SDK (Next.js `ui/`, NEXT_PUBLIC_* are available in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

