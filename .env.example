# ── Postgres (FastAPI `server/`) ─────────────────────────────────────────────
DATABASE_URL=postgresql://cse:cse@127.0.0.1:5433/child_safety_evals

# Optional: only if Next.js cannot forward `Cookie` and you fall back to server-to-server auth.
# INTERNAL_API_SECRET=change-me-to-a-long-random-string

# FastAPI base URL (server-side only; production: https://cse-api.apgardai.com)
INTERNAL_API_URL=http://127.0.0.1:8100

# Optional: set `Domain` on the session cookie for *.apgardai.com (e.g. `.apgardai.com`)
# SESSION_COOKIE_DOMAIN=

# Firebase Admin (Next.js `ui/`) — prefer a service account JSON path (do not commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=../apgard-safe-online-firebase-adminsdk-fbsvc-d4f5701c1a.json
# Or set these instead of the file (e.g. in CI):
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase Web SDK (Next.js `ui/`, NEXT_PUBLIC_* are available in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=apgard-safe-online
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: comma-separated allow list (empty = any Firebase user with a verified email)
# ALLOWED_EMAILS=alice@example.com,bob@example.com
