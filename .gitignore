# Child Safety AI Evaluations (UI + Benchmark)

############################
# OS / editor
############################
.DS_Store
.idea/
.vscode/
*.swp

############################
# Secrets (never commit)
############################
**/.env
**/.env.*
!**/.env.example
**/*firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json

############################
# Node / package managers
############################
**/node_modules/
**/.npm/
**/.yarn-integrity
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

############################
# Builds / caches
############################
**/.next/
**/out/
**/dist/
**/build/
**/*.tsbuildinfo
**/.turbo/
**/.cache/
**/.parcel-cache/
**/.eslintcache
**/.venv/

############################
# Logs
############################
**/*.log
**/logs

############################
# Benchmark outputs
# - pipeline outputs (seeds/scenarios/results)
# - temporary resume files
# - archives
############################
benchmark/data/**
benchmark/data/.benchmark-*-tmp/**
benchmark/**/*.zip

# Results viewer generated artifacts
benchmark/results-viewer/data/viewer-data.json
# Synced copy for Next.js public Test Results page (see ui/scripts/sync-test-results-data.mjs)
ui/public/benchmark/testResults/viewer-data.json
benchmark/results-viewer/archived-results/results.json
benchmark/results-viewer/archived-results/testResults/**

**/*__pycache__/*