# Child Safety AI Evaluations (UI + Benchmark)

############################
# OS / editor
############################
.DS_Store
.idea/
.vscode/
*.swp

############################
# Secrets (never commit)
############################
**/.env
**/.env.*
!**/.env.example
**/*firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json
**/firebase-credentials.json
**/application_default_credentials.json
**/*service-account*.json
server/firebase-credentials.json

############################
# Node / package managers
############################
**/node_modules/
**/.npm/
**/.yarn-integrity
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

############################
# Builds / caches
############################
**/.next/
**/out/
**/dist/
**/build/
**/*.tsbuildinfo
**/.turbo/
**/.cache/
**/.parcel-cache/
**/.eslintcache
**/.venv/
**/.vercel/

############################
# Python (FastAPI server)
############################
**/venv/
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.egg-info/

############################
# Tests / typecheck caches
############################
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

############################
# Logs
############################
**/*.log
**/logs

############################
# Benchmark outputs
# - pipeline outputs (seeds/scenarios/results)
# - temporary resume files
# - archives
############################
benchmark/data/**
!benchmark/data/scenarioSeeds.jsonl
!benchmark/data/scenarios.jsonl
!benchmark/data/model-results/
!benchmark/data/model-results/**
benchmark/data/.benchmark-*-tmp/**
!benchmark/data/model-results/**/.benchmark-run-tmp/
!benchmark/data/model-results/**/.benchmark-run-tmp/**
benchmark/**/*.zip
!benchmark/data/model-results/**/*.zip

# Results viewer generated artifacts
benchmark/results-viewer/data/viewer-data.json
benchmark/results-viewer/archived-results/results.json
benchmark/results-viewer/archived-results/testResults/**

**/dump.rdb
